{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Authors",
  "type": "object",
  "properties": {
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AU\\d{3}$"
          },
          "full_name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64
          },
          "date_of_birth": {
            "type": "string",
            "format": "date"
          },
          "avatar": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["id", "full_name", "date_of_birth", "avatar"]
      }
    }
  },
  "required": ["authors"]
}
