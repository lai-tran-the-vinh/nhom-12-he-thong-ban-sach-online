{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Schema",
  "type": "object",
  "properties": {
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^RV\\d{3}$"
          },
          "book_id": {
            "type": "string",
            "maxLength": 20
          },
          "user_id": {
            "type": "string",
            "maxLength": 20
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "comment": {
            "type": "string",
            "maxLength": 500
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "id",
          "book_id",
          "user_id",
          "rating",
          "comment",
          "date"
        ]
      }
    }
  },
  "required": [
    "reviews"
  ]
}