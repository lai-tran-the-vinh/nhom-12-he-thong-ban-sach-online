{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User Schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 20
    },
    "role_id": {
      "type": "string",
      "maxLength": 20
    },
    "username": {
      "type": "string",
      "maxLength": 50
    },
    "password": {
      "type": "string"
    },
    "numberphone": {
      "type": "string",
      "pattern": "0\\d{9}"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "gender": {
      "type": "string",
      "enum": ["Nam", "Nữ", "Khác"]
    }
  },
  "required": [
    "id",
    "role_id",
    "username",
    "password",
    "numberphone",
    "email",
    "gender"
  ]
}
