{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User Schema",
  "type": "object",
  "properties": {
    "id": { "$ref": "definitions.schema.json#/definitions/KieuMa" },
    "role_id": { "$ref": "definitions.schema.json#/definitions/KieuMaKhoaNgoai" },
    "username": { "$ref": "definitions.schema.json#/definitions/KieuTen" },
    "password": { "type": "string" },
    "numberphone": { "$ref": "definitions.schema.json#/definitions/KieuSoDienThoai" },
    "email": { "$ref": "definitions.schema.json#/definitions/EmailType" },
    "gender": {
      "type": "string",
      "enum": ["Nam", "Nữ", "Khác"]
    }
  },
  "required": ["id", "role_id", "username", "password", "numberphone", "email", "gender"]
}